# CakeCart Environment Configuration

# Neon Serverless PostgreSQL Database URL (pooled connection recommended for Vercel Functions)
# If left empty in local dev, CakeCart uses embedded zero-config PostgreSQL for seamless offline testing
DATABASE_URL=""

# Secret for Vercel Cron jobs (e.g. /api/cron/release-expired-holds)
CRON_SECRET="cakecart_cron_super_secret_2026"

# Session JWT Secret (minimum 32 characters)
SESSION_SECRET="cakecart_secure_jwt_session_secret_cookie_auth_key_2026_xyz"

# Public application base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Vercel Blob Token (optional, used for customer cake reference images)
BLOB_READ_WRITE_TOKEN=""
